{
  "name": "yamak-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.4.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.24",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:customer": "cross-env APP_VARIANT=customer expo start --dev-client --clear",
    "start:captain": "cross-env APP_VARIANT=captain expo start --dev-client --clear",
    "android:customer": "cross-env APP_VARIANT=customer expo run:android",
    "android:captain": "cross-env APP_VARIANT=captain expo run:android",
    "ios:customer": "cross-env APP_VARIANT=customer expo run:ios",
    "ios:captain": "cross-env APP_VARIANT=captain expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "eas:init:customer": "cross-env APP_VARIANT=customer EAS_NO_VCS=1 npx --yes eas-cli@latest init",
    "eas:init:captain": "cross-env APP_VARIANT=captain EAS_NO_VCS=1 npx --yes eas-cli@latest init",
    "apk:customer": "cross-env APP_VARIANT=customer EAS_NO_VCS=1 npx --yes eas-cli@latest build -p android --profile customer-preview",
    "apk:captain": "cross-env APP_VARIANT=captain EAS_NO_VCS=1 npx --yes eas-cli@latest build -p android --profile captain-preview",
    "preview:web": "expo start --web",
    "eas:login": "npx --yes eas-cli@latest login"
  },
  "private": true
}
